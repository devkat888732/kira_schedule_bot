[Unit]
Description=Summer Tasks FastAPI
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/tasks
Environment="PATH=/var/www/tasks/venv/bin"
EnvironmentFile=/var/www/tasks/.env
ExecStart=/var/www/tasks/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
